<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="320.0" prefWidth="560.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chaveztr.ejercicio1_5.PrimaryController">
   <children>
      
      <Label layoutX="30.0" layoutY="25.0" text="Control de Gastos Semanales">
         <font>
           <Font name="System Bold" size="16.0" />
         </font>
      </Label>

      <Label layoutX="30.0" layoutY="80.0" text="Alimentación" />
      <TextField fx:id="txtAlimentacion" layoutX="130.0" layoutY="76.0" prefHeight="25.0" prefWidth="120.0" text="800" />

      <Label layoutX="30.0" layoutY="120.0" text="Refrigerios" />
      <TextField fx:id="txtRefrigerios" layoutX="130.0" layoutY="116.0" prefHeight="25.0" prefWidth="120.0" text="300" />

      <Label layoutX="30.0" layoutY="160.0" text="Transporte" />
      <TextField fx:id="txtTransporte" layoutX="130.0" layoutY="156.0" prefHeight="25.0" prefWidth="120.0" text="600" />

      <Label layoutX="30.0" layoutY="200.0" text="Telefonía" />
      <TextField fx:id="txtTelefonia" layoutX="130.0" layoutY="196.0" prefHeight="25.0" prefWidth="120.0" text="50" />

      <Label layoutX="30.0" layoutY="240.0" text="Otros" />
      <TextField fx:id="txtOtros" layoutX="130.0" layoutY="236.0" prefHeight="25.0" prefWidth="120.0" text="33" />

    
      <Button fx:id="btnCalcular" layoutX="30.0" layoutY="275.0" mnemonicParsing="false" onAction="#handleCalcularEstadisticas" prefHeight="30.0" prefWidth="130.0" text="Calcular estadísticas" />
      <Button fx:id="btnLimpiar" layoutX="175.0" layoutY="275.0" mnemonicParsing="false" onAction="#handleLimpiar" prefHeight="30.0" prefWidth="75.0" text="Limpiar" />

      
      <Label layoutX="320.0" layoutY="80.0" text="Estadísticas">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>

      <Label layoutX="320.0" layoutY="115.0" text="Total semanal" />
      <TextField fx:id="txtTotal" editable="false" layoutX="320.0" layoutY="135.0" prefHeight="25.0" prefWidth="140.0" text="1783" />

      <Label layoutX="320.0" layoutY="180.0" text="Gasto más alto" />
      <TextField fx:id="txtGastoAlto" editable="false" layoutX="320.0" layoutY="200.0" prefHeight="25.0" prefWidth="140.0" text="Alimentación" />
   </children>
</AnchorPane>