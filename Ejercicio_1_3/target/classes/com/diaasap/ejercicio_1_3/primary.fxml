<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_CENTER" spacing="20.0" 
      xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.diaasap.ejercicio_1_3.PrimaryController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <Label text="Ingrese un número" />
            <TextField fx:id="txtNumero" prefWidth="100.0" />
           <Button fx:id="btnAnalizar" text="Analizar" onAction="#btnAnalizar_click" />
            <Button fx:id="btnLimpiar" text="Limpiar" onAction="#btnLimpiar_click" /> 
         </children>
      </HBox>
      
      <HBox spacing="30.0">
         <children>
            <VBox spacing="10.0">
               <children>
                  <HBox spacing="20.0" alignment="CENTER_LEFT">
                     <Label text="Cantidad de cifras" prefWidth="150.0"/>
                     <TextField fx:id="txtCantCifras" editable="false" prefWidth="80.0"/>
                  </HBox>
                  <HBox spacing="20.0" alignment="CENTER_LEFT">
                     <Label text="Suma de cifras impares" prefWidth="150.0"/>
                     <TextField fx:id="txtSumaImpares" editable="false" prefWidth="80.0"/>
                  </HBox>
                  <HBox spacing="20.0" alignment="CENTER_LEFT">
                     <Label text="Suma de cifras pares" prefWidth="150.0"/>
                     <TextField fx:id="txtSumaPares" editable="false" prefWidth="80.0"/>
                  </HBox>
                  <HBox spacing="20.0" alignment="CENTER_LEFT">
                     <Label text="Suma total de cifras" prefWidth="150.0"/>
                     <TextField fx:id="txtSumaTotal" editable="false" prefWidth="80.0"/>
                  </HBox>
                  <HBox spacing="20.0" alignment="CENTER_LEFT">
                     <Label text="Cifra mayor" prefWidth="150.0"/>
                     <TextField fx:id="txtCifraMayor" editable="false" prefWidth="80.0"/>
                  </HBox>
                  <HBox spacing="20.0" alignment="CENTER_LEFT">
                     <Label text="Cifra menor" prefWidth="150.0"/>
                     <TextField fx:id="txtCifraMenor" editable="false" prefWidth="80.0"/>
                  </HBox>
               </children>
            </VBox>
            
            <VBox spacing="5.0">
               <children>
                  <Label text="Divisores" />
                  <TextArea fx:id="txtDivisores" editable="false" prefWidth="180.0" prefHeight="200.0" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>