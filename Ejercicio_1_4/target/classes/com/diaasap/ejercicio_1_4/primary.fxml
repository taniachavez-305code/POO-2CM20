<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" 
      spacing="15.0" 
      xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.diaasap.ejercicio_1_4.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <HBox spacing="15.0" alignment="CENTER">
         <children>
            <VBox spacing="5.0">
               <children>
                  <Label text="Tabla del:" />
                  <TextField fx:id="txtNumero" prefWidth="80.0" />
               </children>
            </VBox>
            
            <VBox spacing="10.0" alignment="CENTER">
               <children>
                  <Button fx:id="btnCalcular" text="Calcular" prefWidth="90.0" onAction="#btnCalcular_click" />
                  <Button fx:id="btnLimpiar" text="Limpiar" prefWidth="90.0" onAction="#btnLimpiar_click" />
               </children>
            </VBox>
         </children>
      </HBox>
      <TextArea fx:id="txtTabla" prefWidth="220.0" prefHeight="200.0" editable="false" />
   </children>
</VBox>