<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" 
      spacing="20.0" 
      xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.diaasap.ejercicio_3_1.PrimaryController">
   <children>
      <Label text="Contar número de clics" />
      <TextField fx:id="txtContador" alignment="CENTER" editable="false" promptText="0" />
      <Button fx:id="btnContar" onAction="#btnContar_click" text="¡Contar!" />
      <VBox prefHeight="15.0" />
      <Label text="Esperar 10 segundos" />
      <ProgressBar fx:id="progressBar" prefWidth="250.0" progress="0.0" />
      <Button fx:id="btnEsperar" onAction="#btnEsperar_click" text="¡Esperar!" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>